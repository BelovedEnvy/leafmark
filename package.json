{
  "name": "leafmark",
  "version": "1.0.0",
  "description": "Ask a question and verify each passage in the source PDF.",
  "scripts": {
    "predev": "node scripts/worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test eval/check.test.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx eval/run.ts",
    "sample": "tsx scripts/sample.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@number-flow/react": "^0.6.2",
    "@supabase/supabase-js": "2.119.2",
    "@tailwindcss/postcss": "4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "gpt-tokenizer": "4.1.2",
    "lucide-react": "1.78.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-pgvector": "0.1.0",
    "@playwright/test": "1.65.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}